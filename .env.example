# Copy to .env. Everything here is optional; the defaults suit a box running Ollama natively.

# Your time zone, so "today" and "overdue" use local time.
TZ=America/Toronto

# Port the web app listens on in your home network: http://<box-ip>:8010
APP_PORT=8010

# Local AI (Ollama). Change the address only if Ollama runs on another computer,
# e.g. http://192.168.1.60:11434
# OLLAMA_URL=http://host.docker.internal:11434

# Model to use if none is picked in Settings.
# OLLAMA_MODEL=llama3.2
