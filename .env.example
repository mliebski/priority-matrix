# Copy to .env. Everything here is optional; the defaults suit a box running Ollama natively.

# Your time zone (e.g. America/Toronto), so "today" and "overdue" use local time.
TZ=UTC

# Port the web app listens on in your home network: http://<box-ip>:8010
APP_PORT=8010

# Password for the web page (any user name). Strongly recommended if others share your network.
# It is sent unencrypted over plain http, so it keeps out curious people, not attackers.
# APP_PASSWORD=

# Address the port is published on. Use 127.0.0.1 to reach the app only from the box itself
# (for example behind a reverse proxy).
# APP_BIND=0.0.0.0

# Local AI (Ollama). Change the address only if Ollama runs on another computer,
# e.g. http://192.168.1.60:11434
# OLLAMA_URL=http://host.docker.internal:11434

# Model to use if none is picked in Settings.
# OLLAMA_MODEL=llama3.2
